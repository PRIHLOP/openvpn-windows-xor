index 0779352..0000000
--- a/windows-nsis/openvpn.nsi
+++ /dev/null
@@ -1,916 +0,0 @@
-; ****************************************************************************
-; * Copyright (C) 2002-2010 OpenVPN Technologies, Inc.                       *
-; * Copyright (C)      2012 Alon Bar-Lev <alon.barlev@gmail.com>             *
